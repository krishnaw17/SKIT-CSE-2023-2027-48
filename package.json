{
  "name": "glms",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified Learning Management System — Rukmani Devi International School",
  "scripts": {
    "dev:web": "pnpm --filter @glms/web dev",
    "dev:server": "pnpm --filter @glms/server dev",
    "build:web": "pnpm --filter @glms/web build",
    "build:server": "pnpm --filter @glms/server build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @glms/server db:migrate",
    "db:generate": "pnpm --filter @glms/server db:generate",
    "db:studio": "pnpm --filter @glms/server db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
