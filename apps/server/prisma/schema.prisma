// =============================================================================
// GLMS — Enterprise Prisma Schema
// XYZ School Gamified Learning Management System
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum PermissionResource {
  USERS
  CLASSES
  SUBJECTS
  COURSES
  LESSONS
  ASSIGNMENTS
  QUIZZES
  ATTENDANCE
  GRADES
  ANNOUNCEMENTS
  NOTIFICATIONS
  REPORTS
  SETTINGS
  BADGES
  GAMIFICATION
}

enum LessonType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  ASSIGNMENT_DUE
  ASSIGNMENT_GRADED
  QUIZ_AVAILABLE
  QUIZ_RESULT
  BADGE_EARNED
  LEVEL_UP
  ACHIEVEMENT_UNLOCKED
  ANNOUNCEMENT
  ENROLLMENT
  STREAK_REMINDER
  SYSTEM
}

enum AnnouncementScope {
  GLOBAL
  CLASS
  COURSE
}

enum XPSource {
  QUIZ_COMPLETION
  QUIZ_PERFECT_SCORE
  ASSIGNMENT_SUBMISSION
  ASSIGNMENT_GRADE
  ATTENDANCE
  DAILY_STREAK
  WEEKLY_STREAK
  BADGE_BONUS
  MANUAL_AWARD
}

enum LeaderboardType {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

// =============================================================================
// IDENTITY & ACCESS
// =============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(STUDENT)
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  profile           StudentProfile?
  teacherProfile    TeacherProfile?
  adminProfile      AdminProfile?
  rolePermissions   UserPermission[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  sentAnnouncements Announcement[]  @relation("AnnouncementAuthor")

  @@index([email])
  @@index([role])
  @@map("users")
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  firstName       String
  lastName        String
  displayName     String?
  avatarUrl       String?
  bio             String?
  dateOfBirth     DateTime?
  phoneNumber     String?
  parentEmail     String?
  admissionNumber String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  enrollments     Enrollment[]
  submissions     AssignmentSubmission[]
  quizAttempts    QuizAttempt[]
  lessonProgress  LessonProgress[]
  attendance      Attendance[]
  xpTransactions  XPTransaction[]
  streak          Streak?
  badges          StudentBadge[]
  achievements    StudentAchievement[]
  leaderboards    LeaderboardEntry[]

  @@index([userId])
  @@index([classId])
  @@index([admissionNumber])
  @@map("student_profiles")
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  firstName       String
  lastName        String
  displayName     String?
  avatarUrl       String?
  bio             String?
  employeeNumber  String?  @unique
  department      String?
  qualification   String?
  phoneNumber     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects   ClassSubject[]
  courses         Course[]
  assignments     Assignment[]
  quizzes         Quiz[]
  attendanceMarks Attendance[]  @relation("AttendanceMarker")

  @@index([userId])
  @@map("teacher_profiles")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_profiles")
}

// Fine-grained permission overrides per user
model Permission {
  id       String             @id @default(cuid())
  action   PermissionAction
  resource PermissionResource
  name     String             @unique // e.g. "courses:create"
  description String?

  userPermissions UserPermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  grantedBy    String?
  grantedAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  deviceHash  String   // SHA256(user-agent + ip)
  deviceLabel String?  // "Chrome on Windows"
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================================================
// ACADEMIC STRUCTURE
// =============================================================================

model AcademicSession {
  id          String        @id @default(cuid())
  name        String        // "2024-2025"
  startDate   DateTime
  endDate     DateTime
  status      SessionStatus @default(UPCOMING)
  isCurrent   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  classes     Class[]

  @@index([isCurrent])
  @@map("academic_sessions")
}

model Class {
  id                String          @id @default(cuid())
  name              String          // "Grade 10-A"
  gradeLevel        String          // "Grade 10"
  section           String          // "A"
  academicSessionId String
  roomNumber        String?
  capacity          Int             @default(40)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  students          StudentProfile[]
  classSubjects     ClassSubject[]
  announcements     Announcement[]  @relation("ClassAnnouncements")
  leaderboard       LeaderboardEntry[]
  courses           Course[]

  @@unique([name, academicSessionId])
  @@index([academicSessionId])
  @@map("classes")
}

model Subject {
  id          String    @id @default(cuid())
  name        String    // "Mathematics"
  code        String    @unique // "MATH10"
  description String?
  iconUrl     String?
  color       String?   // Hex color for UI
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classSubjects ClassSubject[]
  courses       Course[]

  @@index([code])
  @@map("subjects")
}

model ClassSubject {
  id        String         @id @default(cuid())
  classId   String
  subjectId String
  teacherId String         // TeacherProfile.id
  schedule  Json?          // { days: ["MON","WED"], time: "09:00" }
  createdAt DateTime       @default(now())

  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@index([teacherId])
  @@map("class_subjects")
}

// =============================================================================
// COURSES & CONTENT
// =============================================================================

model Course {
  id            String         @id @default(cuid())
  title         String
  description   String?
  thumbnailUrl  String?
  subjectId     String
  teacherId     String
  classId       String?        // Made optional to support general courses or class-specific
  isPublished   Boolean        @default(false)
  xpReward      Int            @default(0)  // XP on course completion
  estimatedHours Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id])
  class         Class?         @relation(fields: [classId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  assignments   Assignment[]
  quizzes       Quiz[]
  announcements Announcement[] @relation("CourseAnnouncements")

  @@index([subjectId])
  @@index([teacherId])
  @@index([isPublished])
  @@map("courses")
}

model Enrollment {
  id               String         @id @default(cuid())
  studentId        String
  courseId         String
  enrolledAt       DateTime       @default(now())
  completedAt      DateTime?
  progressPercent  Float          @default(0)
  xpEarned         Int            @default(0)

  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Lesson {
  id           String         @id @default(cuid())
  courseId     String
  title        String
  description  String?
  type         LessonType
  contentUrl   String?        // Cloudinary URL for video/pdf
  contentText  String?        // Rich text / markdown
  duration     Int?           // minutes (for video)
  order        Int            // Ordering within course
  isPublished  Boolean        @default(false)
  xpReward     Int            @default(5)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]

  @@index([courseId, order])
  @@map("lessons")
}

model LessonProgress {
  id           String         @id @default(cuid())
  studentId    String
  lessonId     String
  isCompleted  Boolean        @default(false)
  watchedSeconds Int          @default(0)  // for video lessons
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@map("lesson_progress")
}

// =============================================================================
// ASSIGNMENTS
// =============================================================================

model Assignment {
  id              String            @id @default(cuid())
  courseId        String
  teacherId       String
  title           String
  description     String
  status          AssignmentStatus  @default(DRAFT)
  dueDate         DateTime
  maxScore        Float             @default(100)
  passingScore    Float             @default(50)
  allowLate       Boolean           @default(false)
  latePenaltyPct  Float             @default(0)
  xpReward        Int               @default(15)
  attachmentUrls  String[]          // Cloudinary URLs
  instructions    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         TeacherProfile    @relation(fields: [teacherId], references: [id])
  submissions     AssignmentSubmission[]

  @@index([courseId])
  @@index([teacherId])
  @@index([dueDate])
  @@index([status])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now())
  fileUrls      String[]         // Cloudinary URLs
  textContent   String?
  score         Float?
  feedback      String?
  gradedAt      DateTime?
  gradedBy      String?          // TeacherProfile.id
  xpAwarded     Int?
  isLate        Boolean          @default(false)
  updatedAt     DateTime         @updatedAt

  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

// =============================================================================
// QUIZZES
// =============================================================================

model Quiz {
  id              String         @id @default(cuid())
  courseId        String
  teacherId       String
  title           String
  description     String?
  status          QuizStatus     @default(DRAFT)
  timeLimit       Int?           // minutes; null = unlimited
  maxAttempts     Int            @default(1)
  passingScore    Float          @default(50)
  xpReward        Int            @default(10)
  xpBonusPerfect  Int            @default(20)
  shuffleQuestions Boolean       @default(false)
  shuffleOptions  Boolean        @default(false)
  showResultsAt   QuizResultVisibility @default(IMMEDIATELY)
  availableFrom   DateTime?
  availableUntil  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  questions       Question[]
  attempts        QuizAttempt[]

  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@map("quizzes")
}

enum QuizResultVisibility {
  IMMEDIATELY
  AFTER_DUE
  MANUAL
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  type         QuestionType
  text         String
  imageUrl     String?
  order        Int
  points       Float        @default(1)
  explanation  String?      // Shown after attempt
  isRequired   Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      Option[]
  answers      QuizAnswer[]

  @@index([quizId, order])
  @@map("questions")
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("options")
}

model QuizAttempt {
  id           String         @id @default(cuid())
  quizId       String
  studentId    String
  attemptNumber Int
  startedAt    DateTime       @default(now())
  submittedAt  DateTime?
  score        Float?
  maxScore     Float?
  isPassed     Boolean?
  xpAwarded    Int?
  timeTaken    Int?           // seconds
  createdAt    DateTime       @default(now())

  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id           String       @id @default(cuid())
  attemptId    String
  questionId   String
  selectedOptionId String?  // For MCQ/TF
  textAnswer   String?      // For SHORT_ANSWER
  isCorrect    Boolean?
  pointsEarned Float?
  createdAt    DateTime     @default(now())

  attempt      QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_answers")
}

// =============================================================================
// GAMIFICATION
// =============================================================================

model XPTransaction {
  id          String         @id @default(cuid())
  studentId   String
  source      XPSource
  amount      Int
  description String
  referenceId String?        // ID of quiz/assignment/etc.
  createdAt   DateTime       @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([source])
  @@index([createdAt])
  @@map("xp_transactions")
}

model Level {
  id          String   @id @default(cuid())
  levelNumber Int      @unique
  label       String   // "Novice", "Explorer", "Scholar", "Legend"
  minXP       Int
  maxXP       Int
  iconUrl     String?
  color       String?
  perks       Json?    // Additional level perks
  createdAt   DateTime @default(now())

  @@index([levelNumber])
  @@index([minXP])
  @@map("levels")
}

model Badge {
  id          String         @id @default(cuid())
  name        String         @unique
  description String
  iconUrl     String
  color       String?
  category    String         // "academic", "streak", "social", "special"
  triggerRule Json           // { type: "quiz_score", threshold: 100 }
  xpBonus     Int            @default(0)
  isActive    Boolean        @default(true)
  rarity      BadgeRarity    @default(COMMON)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  students    StudentBadge[]

  @@map("badges")
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model StudentBadge {
  id        String         @id @default(cuid())
  studentId String
  badgeId   String
  awardedAt DateTime       @default(now())
  awardedBy String?        // "system" or admin userId

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
  @@map("student_badges")
}

model Achievement {
  id          String               @id @default(cuid())
  name        String               @unique
  description String
  iconUrl     String
  condition   Json                 // { type: "streak_days", value: 30 }
  xpBonus     Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  students    StudentAchievement[]

  @@map("achievements")
}

model StudentAchievement {
  id            String         @id @default(cuid())
  studentId     String
  achievementId String
  unlockedAt    DateTime       @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@map("student_achievements")
}

model Streak {
  id              String         @id @default(cuid())
  studentId       String         @unique
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastActiveDate  DateTime?
  weeklyStreak    Int            @default(0)
  updatedAt       DateTime       @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model LeaderboardEntry {
  id         String          @id @default(cuid())
  studentId  String
  classId    String?
  type       LeaderboardType
  period     String          // "2024-W32", "2024-08"
  totalXP    Int
  rank       Int
  quizAvg    Float           @default(0)
  badges     Int             @default(0)
  updatedAt  DateTime        @updatedAt

  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class?          @relation(fields: [classId], references: [id])

  @@unique([studentId, type, period, classId])
  @@index([type, period, classId])
  @@index([rank])
  @@map("leaderboard_entries")
}

// =============================================================================
// ATTENDANCE
// =============================================================================

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  classId     String?
  subjectId   String?
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedById  String           // TeacherProfile.id
  note        String?
  xpAwarded   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    TeacherProfile   @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([studentId, date, subjectId])
  @@index([studentId])
  @@index([date])
  @@index([classId])
  @@map("attendance")
}

// =============================================================================
// COMMUNICATIONS
// =============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // Extra context (e.g. quizId, badgeId)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Announcement {
  id          String            @id @default(cuid())
  authorId    String
  title       String
  body        String
  scope       AnnouncementScope @default(GLOBAL)
  classId     String?
  courseId    String?
  isPinned    Boolean           @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  author      User              @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  class       Class?            @relation("ClassAnnouncements", fields: [classId], references: [id])
  course      Course?           @relation("CourseAnnouncements", fields: [courseId], references: [id])

  @@index([scope])
  @@index([classId])
  @@index([courseId])
  @@map("announcements")
}

// =============================================================================
// SYSTEM
// =============================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  resource   String   // "User", "Course", "Quiz"
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
